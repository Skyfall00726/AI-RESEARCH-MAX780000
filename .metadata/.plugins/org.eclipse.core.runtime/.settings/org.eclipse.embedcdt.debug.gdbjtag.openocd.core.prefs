eclipse.preferences.version=1
gdb.client.commands=set mem inaccessible-by-default off
gdb.client.doStart=true
gdb.client.executable=arm-none-eabi-gdb
gdb.client.other=
gdb.openocd.doDebugInRam=false
gdb.openocd.doInitialReset=true
gdb.openocd.doPreRunReset=false
gdb.openocd.enableSemihosting=false
gdb.openocd.init.other=
gdb.openocd.initialReset.type=init
gdb.openocd.preRun.other=
gdb.openocd.preRunReset.type=
gdb.server.doStart=true
gdb.server.executable=openocd
gdb.server.other=-s ${env_var\:TOOLCHAIN_PATH}/OpenOCD/scripts -f  interface/cmsis-dap.cfg -f target/max78000.cfg -c "adapter speed 400"   -c "transport select swd" -c "reset_config srst_only srst_nogate"   -c "init"   -c "reset halt"
